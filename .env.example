# 복사해서 .env로 쓴다. .env는 커밋하지 않는다.

# 사건 데이터
# CASES_DIR=/절대/경로/cases   (기본값: 저장소의 cases/)
DEFAULT_CASE_ID=museum-001
DATABASE_URL=sqlite:///./caseforge.db

# 모델 어댑터: mock | ollama | llamacpp  (CI와 테스트는 mock)
LLM_BACKEND=mock
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 임베딩: mock | bge
EMBEDDING_BACKEND=mock
