# 복사해서 .env 로 쓴다. .env 는 커밋하지 않는다.

# 모델 어댑터: mock | ollama | llamacpp  (CI와 테스트는 mock)
LLM_BACKEND=mock
LLM_MODEL=qwen3:8b-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# 임베딩 어댑터: mock | bge
EMBEDDING_BACKEND=mock

# 사건 데이터
# CASES_DIR=/abs/path/to/cases   (기본값: 저장소의 cases/)
DEFAULT_CASE_ID=museum-001
