        "title": "CollectResponse"
      },
      "ContradictionView": {
        "properties": {
          "npc_id": {
            "type": "string",
            "title": "Npc Id"
          },
          "statement_turn": {
            "type": "integer",
            "title": "Statement Turn"
          },
          "statement": {
            "type": "string",
            "title": "Statement"
          },
          "evidence_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Id"
          },
          "evidence_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Name"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "other_statements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Other Statements"
          }
        },
        "type": "object",
        "required": [
          "npc_id",
          "statement_turn",
          "statement",
          "evidence_id",
          "evidence_name",
          "type",
          "source"
        ],
        "title": "ContradictionView"
      },
      "CreateSessionRequest": {
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "title": "Case Id",
            "default": "museum-001"
          }
        },
        "type": "object",
        "title": "CreateSessionRequest"
