  "components": {
    "schemas": {
      "AskDebug": {
        "properties": {
          "grounding_fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Grounding Fact Ids"
          },
          "used_lie_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Used Lie Ids"
          },
          "guard_violations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Guard Violations"
          },
          "regenerated": {
            "type": "boolean",
            "title": "Regenerated"
          },
          "fallback": {
            "type": "boolean",
            "title": "Fallback"
          },
          "llm_calls": {
            "type": "integer",
            "title": "Llm Calls"
          }
        },
        "type": "object",
        "required": [
          "grounding_fact_ids",
          "used_lie_ids",
          "guard_violations",
          "regenerated",
          "fallback",
          "llm_calls"
        ],
        "title": "AskDebug",
        "description": "개발자 모드 전용 (DEBUG_API=true일 때만 채운다)."
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AskRequest"
      },
      "AskResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "emotion": {
            "type": "string",
            "title": "Emotion"
          },
          "revealed_fact_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Revealed Fact Ids"
          },
          "contradiction_detected": {
            "type": "boolean",
            "title": "Contradiction Detected"
          },
          "trust_delta": {
            "type": "integer",
            "title": "Trust Delta"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "debug": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AskDebug"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "answer",
          "emotion",
          "revealed_fact_ids",
          "contradiction_detected",
          "trust_delta",
          "turn"
        ],
        "title": "AskResponse",
        "description": "기획서의 Interrogation 출력 형식."
      },
      "BoardView": {
        "properties": {
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceView"
            },
            "type": "array",
            "title": "Evidence"
          },
          "statements": {
            "items": {
              "$ref": "#/components/schemas/StatementView"
            },
            "type": "array",
            "title": "Statements"
          },
          "contradictions": {
            "items": {
              "$ref": "#/components/schemas/ContradictionView"
            },
            "type": "array",
            "title": "Contradictions"
          }
        },
        "type": "object",
        "required": [
          "evidence",
          "statements",
          "contradictions"
        ],
        "title": "BoardView"
      },
      "BriefingView": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "damage": {
            "type": "string",
            "title": "Damage"
          },
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "public_facts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Public Facts"
          }
        },
        "type": "object",
        "required": [
          "title",
          "summary",
          "damage",
          "objective",
          "public_facts"
        ],
        "title": "BriefingView"
      },
      "CollectResponse": {
        "properties": {
          "evidence": {
            "$ref": "#/components/schemas/EvidenceView"
          },
          "puzzles": {
            "items": {
              "$ref": "#/components/schemas/PuzzleView"
            },
            "type": "array",
            "title": "Puzzles"
          },
          "contradictions_found": {
            "type": "integer",
            "title": "Contradictions Found"
          }
        },
        "type": "object",
        "required": [
